# Copy to .env (or bot.env in the data folder) and fill in. Container settings win over bot.env.

# --- Discord ------------------------------------------------------------------------------
# Discord Developer Portal → your music bot application → Bot → Reset Token.
DISCORD_TOKEN=
# Your own Discord user ID (who approves servers). Leave empty to use the application's owner.
# Discord → Settings → Advanced → Developer Mode, then right-click yourself → Copy User ID.
OWNER_ID=
# Servers to approve without asking, comma separated (servers you own are approved anyway).
ALLOWED_GUILD_IDS=

# --- Your music library -------------------------------------------------------------------
# Aurral's address, the same one you open in the browser (e.g. http://aurral:3001).
# Any Subsonic server works too (Navidrome, gonic…).
SUBSONIC_URL=
# A local Aurral account just for the bot (e.g. "discord"). Sign in to Aurral with it once in a browser.
SUBSONIC_USER=
# That account's password (Aurral API keys don't work for this).
SUBSONIC_PASSWORD=
# Stream bitrate in kbps (Discord voice tops out around 128 on unboosted servers).
MUSIC_BITRATE=128

# --- Tuning (defaults are fine) -----------------------------------------------------------
# Leave the voice channel after this many minutes with nothing playing or nobody listening.
IDLE_MINUTES=5
# Port for the container's own health check (GET /healthz). Nothing needs to reach it.
HEALTH_PORT=8080
# How long to wait for the music library to answer, in milliseconds.
HTTP_TIMEOUT_MS=10000
# debug, info, warn or error.
LOG_LEVEL=info
DATA_DIR=/data
