{
  "name": "music-bot",
  "version": "1.0.0",
  "description": "Self-hosted Discord music bot that plays your own library (Aurral or any Subsonic server) in voice channels, across the servers you approve.",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/index.js",
    "test": "npm run build && node --test --test-timeout=60000 --test-force-exit \"test/*.test.mjs\""
  },
  "license": "MIT",
  "dependencies": {
    "@discordjs/voice": "^0.19.2",
    "better-sqlite3": "^13.2.0",
    "discord.js": "^14.28.1",
    "opusscript": "^0.0.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2"
  }
}
